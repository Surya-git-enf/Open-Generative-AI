# NVIDIA NIM (Cosmos3 Nano video generation). Server-side only: never prefix with NEXT_PUBLIC_.
# Get a key at https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=nvapi-your_api_key_here

# Optional tuning
# NVIDIA_COSMOS_URL=https://ai.api.nvidia.com/v1/cosmos/nvidia/cosmos3-nano
# NVIDIA_COSMOS_STEPS=35
# NVIDIA_TIMEOUT_MS=900000
# NVIDIA_MAX_UPLOAD_MB=100
# NVIDIA_DATA_DIR=./.nvidia-data
